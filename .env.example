# Codigo de pais por defecto (Guatemala: 502, Mexico: 52, Argentina: 54)
# Se aplica automaticamente si el numero no incluye el codigo de pais
COUNTRY_CODE=502

# Numero desde el que se envia (tu numero de WhatsApp)
# Puedes escribirlo con o sin el codigo de pais
# Ejemplo con codigo: 50212345678
# Ejemplo sin codigo: 12345678 (se agrega +502 automaticamente)
FROM_PHONE=12345678

# Numero destino (a quien se le envian los mensajes)
TARGET_PHONE=87654321

# Horarios de envio (formato 24h)
MORNING_HOUR=8
MORNING_MINUTE=0
EVENING_HOUR=18
EVENING_MINUTE=0

# Delay aleatorio maximo en minutos (para parecer mas natural)
MAX_DELAY_MINUTES=5

# Zona horaria (lista completa: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=America/Guatemala
